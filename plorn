        b.grid(column=1, row=7)

    def update_albumview(self):
        for ii in self.aview.get_children():
            self.aview.delete(ii)
        self.album_list.clear()
        self.album_list = self.db.get_albums()
        self.album_list.sort(key=lambda x: x["name"])
        logger.debug(f"update to: {str(self.album_list)}")
        for ii in self.album_list:
            self.aview.insert("", END,
                              text=ii["id"],
                              values=(ii["name"], ii["path"],
                                      ii["photo_count"]))
        self.aview.focus_set()
        child_id = self.aview.get_children()[0]
        self.aview.focus(child_id)
        self.aview.selection_set(child_id)

        self.album_count_label.set(f"Albums: {self.db.album_count()}")
        self.photo_count_label.set(f"Photos: {self.db.photo_count()}")

    def create_symlink(self):
        linkname = os.path.join(config.get_datadir(),
                                f"album{self.current_album.get_id():04}")
        fullpath = os.path.expanduser(self.current_album.get_path())
        actualdir = os.path.abspath(fullpath)
        logger.debug(f"symlink {linkname} to {actualdir}")
        os.symlink(actualdir, linkname, target_is_directory=True)
        return linkname

    def collect_images(self, linkname):
        photo_list = []
        entries = os.listdir(linkname)
        for ii in entries:
            fullpath = os.path.join(linkname, ii)
            logger.debug(f"checking file type of {fullpath}")
            if os.path.isfile(fullpath):
                if filetype.is_image(fullpath):
                    logger.debug(f"collected image {fullpath}")
                    photo_list.append(fullpath)
        return photo_list

    def add_album(self):
        logger.debug("adding album")
        addone = plorn_album.PlornAddAlbum(self, self.album_list)
        addone.grab_set()
        self.wait_window(addone)
        
        album_id = self.db.get_last_album_id()
        if album_id != None:
            row = self.db.get_album_by_id(album_id)
            self.current_album = plorn_album.PlornAlbum(row["name"],
                                        row["path"], id=row["id"],
                                        dated=row["dated"], notes=row["notes"])
            logger.debug(f"add photos to {self.current_album.get_name()}")
            linkname = self.create_symlink()
            photo_list = self.collect_images(linkname)
            album_id = self.current_album.get_id()
            self.photo_list.clear()
            self.button_imgs.clear()
            for ii in photo_list:
                name = os.path.basename(ii)
                photo = plorn_photo.PlornPhoto(name, ii, id=None,
                                               album_id=album_id)
                logger.debug(f"add photo {ii} with album_id {album_id}")
                id = self.db.add_photo(photo, album_id)
            for ii in self.db.get_photos(album_id):
                self.photo_list.append(ii)
            logger.debug(f"photo_list {str(self.photo_list)}")
            self.update_photoview(album_id)
            self.update_albumview()

    def remove_album(self):
        row = self.aview.focus()
        if row != "":
            album = self.aview.item(row)
            album_name = album["values"][0]
            logger.debug(f"remove album {album_name}")
            rmone = plorn_album.PlornRemoveAlbum(self, album_name,
                                                 self.album_list)
            rmone.grab_set()
            self.wait_window(rmone)
            self.update_albumview()
        else:
            messagebox.showerror(parent=self,
                                 title="Select an Album",
                                 detail="Please select an album to remove")

    def album_info(self):
        row = self.aview.focus()
        if row != "":
            album = self.aview.item(row)
            album_name = album["values"][0]
            logger.debug(f"show info for {album_name}")
            showone = plorn_album.PlornShowAlbum(self, album_name)
            showone.grab_set()
            self.wait_window(showone)
        else:
            messagebox.showerror(parent=self,
                                 title="Select an Album",
                                 detail="Please select an album to show")

    def up_photo(self, event):
        cur = self.last_button_img
        child = self.pview.prev(cur)
        if not child:
            child = cur
        logger.debug(f"up_photo selection: {str(cur)} -> {str(child)}")
        self.pview.selection_set(child)
        self.set_button_img(child)
        self.last_button_img = child

    def down_photo(self, event):
        cur = self.last_button_img
        child = self.pview.next(cur)
        if not child:
            child = cur
        logger.debug(f"down_photo selection: {str(cur)} -> {str(child)}")
        self.pview.selection_set(child)
        self.set_button_img(child)
        self.last_button_img = child

    def set_button_img(self, child):
        logger.debug(f"set_button_img entry: {str(child)}")
        if child != "":
            logger.debug(f"set_button_img: [{len(self.button_imgs)}] {str(child)}")
            self.current_photo.config(image=self.button_imgs[child])

    def update_photoview(self, album_id):
        for ii in self.pview.get_children():
            self.pview.delete(ii)
        self.photo_list.clear()
        self.photo_list = self.db.get_photos(album_id)
        self.photo_list.sort(key=lambda x: x["id"])
        self.button_imgs.clear()
        logger.debug(f"update to: {str(self.photo_list)}")
        for ii in self.photo_list:
            child = self.pview.insert("", END,
                                      text=ii["id"],
                                      values=(ii["name"], ii["path"]))
            raw_img = pilImage.open(ii["path"])
            thumbnail = raw_img.resize((100,100))
            button_img = ImageTk.PhotoImage(image=thumbnail)
            self.button_imgs[child] = button_img
            logger.debug(f"add btn img for child {child} from {ii["path"]}")

        self.pview.focus_set()
        child_id = self.pview.get_children()[0]
        self.last_button_img = child_id
        self.pview.selection_set(child_id)
        self.pview.focus(child_id)
        self.set_button_img(child_id)

    def got_called(self, event):
        logger.debug(f"got called for {str(event)}")

    def open_album(self):
        row = self.aview.focus()
        if row != "":
            album_info = self.aview.item(row)
            album_name = album_info["values"][0]
            logger.debug(f"open album {album_name}")
            self.notebook.select(self.photos_tab)

            album_row = self.db.get_album_by_name(album_name)
            self.update_photoview(album_row["id"])
        else:
            messagebox.showerror(parent=self,
                                 title="Select an Album",
                                 detail="Please select an album to open")

    def edit_album(self):
        row = self.aview.focus()
        if row != "":
            album = self.aview.item(row)
            album_name = album["values"][0]
            logger.debug(f"edit album {album_name}")
            showone = plorn_album.PlornEditAlbum(self,
                                                 album_name,
                                                 self.album_list)
            showone.grab_set()
            self.wait_window(showone)
            self.update_albumview()
        else:
            messagebox.showerror(parent=self,
                                 title="Select an Album",
                                 detail="Please select an album to edit")

