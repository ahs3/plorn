            parent_id = name_entry["values"][1]
            logger.debug(f"edit name {str(entry)}")
            showone = plorn_name.PlornEditName(self, name, name_id,
                                               parent_id=parent_id)
            showone.grab_set()
            self.wait_window(showone)
            self.update_nameview()
