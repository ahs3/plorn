    def update_albumview(self):
        for ii in self.aview.get_children():
            self.aview.delete(ii)
        self.album_list.clear()
        self.album_list = self.db.get_albums()
        self.album_list.sort(key=lambda x: x["name"])
        logger.debug(f"update to: {str(self.album_list)}")
        for ii in self.album_list:
            self.aview.insert("", END,
                              text=ii["id"],
                              values=(ii["name"], ii["path"],
                                      ii["photo_count"]))
        self.aview.focus_set()
        kids = self.aview.get_children()
        if len(kids) > 0:
            child_id = kids[0]
            if child_id != "":
                self.aview.focus(child_id)
                self.aview.selection_set(child_id)
                entry = self.aview.item(child_id)
                self.current_album = self.db.get_album_object(entry["text"])
                self.current_album_name.set(self.current_album.get_name())

        self.album_count_label.set(f"Albums: {self.db.album_count()}")
        self.photo_count_label.set(f"Photos: {self.db.photo_count()}")

    def get_symlink(self):
        linkname = os.path.join(config.get_datadir(),
                                f"album{self.current_album.get_id():04}")
        if not (os.path.exists(linkname) and os.path.islink(linkname)):
            fullpath = os.path.expanduser(self.current_album.get_path())
            actualdir = os.path.abspath(fullpath)
            logger.debug(f"symlink {linkname} to {actualdir}")
            os.symlink(actualdir, linkname, target_is_directory=True)
        return linkname

    def collect_images(self, linkname):
        photo_list = []
        entries = os.listdir(linkname)
        for ii in entries:
            fullpath = os.path.join(linkname, ii)
            logger.debug(f"checking file type of {fullpath}")
            if os.path.isfile(fullpath):
                if filetype.is_image(fullpath):
                    logger.debug(f"collected image {fullpath}")
                    photo_list.append(fullpath)
        return photo_list

    def add_album(self):
        logger.debug("adding album")
        addone = plorn_album.PlornAddAlbum(self, self.album_list)
        addone.grab_set()
        self.wait_window(addone)
        
        album_id = self.db.get_last_album_id()
        if album_id != None:
            row = self.db.get_album_by_id(album_id)
            self.current_album = plorn_album.PlornAlbum(row["name"],
                                        row["path"], id=row["id"],
                                        dated=row["dated"], notes=row["notes"])
            logger.debug(f"add photos to {self.current_album.get_name()}")
            linkname = self.get_symlink()
            photo_list = self.collect_images(linkname)
            album_id = self.current_album.get_id()
            self.photo_list.clear()
            self.button_imgs.clear()
            for ii in photo_list:
                name = os.path.basename(ii)
                photo = plorn_photo.PlornPhoto(name, ii, id=None,
                                               album_id=album_id)
                logger.debug(f"add photo {ii} with album_id {album_id}")
                id = self.db.add_photo(photo, album_id)
            for ii in self.db.get_photos(album_id):
                self.photo_list.append(ii)
            logger.debug(f"photo_list {str(self.photo_list)}")
            self.update_photoview(album_id)
            self.update_albumview()

    def remove_album(self):
