    def remove_name(self):
        entry_id = self.nview.focus()
        if entry_id == "":
            messagebox.showerror(parent=self,
                                 title="Remove Name",
                                 detail="Please select a name to remove")
            return
        entry = self.nview.item(entry_id)
        logger.debug(f"entry: {str(entry)}")
        e_id = entry["values"][0]
        e_pid = entry["values"][1]
        name = self.db.get_name_object(e_id, parent_id=e_pid)
        name_id = name.get_id()
        parent_id = name.get_parent_id()
        logger.debug(f"removing name {name.get_name()} from {parent_id}")
        rmone = plorn_name.PlornRemoveName(self, name_id, parent_id)
        rmone.grab_set()
        self.wait_window(rmone)
        self.update_nameview()

